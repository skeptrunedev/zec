{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zec",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "routes": [{ "pattern": "zec.skeptrune.com", "custom_domain": true }],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    // Only the live-stats endpoint needs the Worker; the page is a static asset.
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
